# 电商智能客服Agent 环境变量配置
# 复制此文件为 .env 并填入真实值

# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_cs

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === LLM (DeepSeek推荐) ===
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# === Dify ===
DIFY_API_URL=http://localhost/v1
DIFY_API_KEY=app-your-dify-key

# === 淘宝开放平台 ===
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=

# === 拼多多开放平台 ===
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=

# === 抖店开放平台 ===
DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=

# === 京东开放平台 ===
JD_APP_KEY=
JD_APP_SECRET=

# === 回调地址 ===
CALLBACK_BASE_URL=http://your-server:8000

# === 安全 ===
JWT_SECRET_KEY=change-me-to-a-random-string
